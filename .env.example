# 本地开发默认值；生产部署请只保留必要项并通过受控环境注入，不要提交真实 Key。
YUEJI_DATA_DIR=./data
YUEJI_DATABASE=yueji.sqlite3
YUEJI_SEED_SAMPLES=true
YUEJI_AI_MODE=real
YUEJI_ENABLE_REAL_PROVIDERS=true

# 邀请制账号。生产必须为 true，且 YUEJI_ENV=production 时缺失主密钥会拒绝启动。
YUEJI_AUTH_REQUIRED=true
YUEJI_ENV=local
YUEJI_SECURE_COOKIES=false
YUEJI_SESSION_TTL_DAYS=7

# DeepSeek 默认可用域名；管理员可按需收窄或补充官方兼容域名，普通用户不能在应用内扩展。
YUEJI_ALLOWED_API_HOSTS=api.deepseek.com,api.openai.com,api.moonshot.cn,api.groq.com,openrouter.ai,api.together.xyz

# 生产必须设置 Fernet 主密钥，例如：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# YUEJI_MASTER_KEY=

# 仅本地显式允许在 data/.master_key 生成受限主密钥；生产不要开启。
YUEJI_ALLOW_LOCAL_KEY_FILE=false

# 仅自动化测试使用；生产环境自动失效。
# YUEJI_TEST_INVITE_CODE=

# 可选：托管试用首次启动时创建一个初始邀请码（普通邀请，不是主密钥）。
# YUEJI_BOOTSTRAP_INVITE_CODE=

# 不要在浏览器 VITE_* 变量、localStorage 或本文件中填写真实 API Key。

# WorkBuddy 云服务（前端公开三项，均由你自己的应用 publicConfig 提供）
VITE_WB_ENDPOINT=
VITE_WB_OAUTH_RELAY=
VITE_WB_PUBLISHABLE_KEY=
